# Safe for browser use; Row Level Security still governs database access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Reserved for trusted administrative tasks; normal user routes do not use it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OpenAI-compatible provider configuration.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
